<%= content_for :page_title, t(".title") %>

<div class="space-y-6">
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <p class="text-sm text-secondary mb-4"><%= t(".description") %></p>

    <%= form_with model: @import_exclusion, url: import_exclusions_path, class: "flex gap-2" do |f| %>
      <%= f.text_field :name, placeholder: t(".name_placeholder"), class: "flex-1 rounded-lg border border-secondary bg-container px-3 py-2 text-sm text-primary" %>
      <%= render DS::Button.new(text: t(".add"), type: :submit, variant: "primary") %>
    <% end %>
  </div>

  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <% if @import_exclusions.empty? %>
      <p class="text-sm text-secondary text-center py-8"><%= t(".empty") %></p>
    <% else %>
      <div class="space-y-1">
        <% @import_exclusions.each do |exclusion| %>
          <div class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg hover:bg-surface-hover">
            <span class="text-sm text-primary font-mono truncate"><%= exclusion.name %></span>
            <%= render DS::Button.new(
              text: t(".delete"),
              href: import_exclusion_path(exclusion),
              method: :delete,
              variant: "destructive",
              size: "sm",
              data: { turbo_confirm: t(".delete_confirm", name: exclusion.name) }
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
