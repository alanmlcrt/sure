<%= content_for :header_nav do %>
  <%= render "imports/nav", import: @import %>
<% end %>

<%= content_for :previous_path, imports_path %>

<% select_class = "w-full rounded-lg border border-secondary bg-container px-3 py-2 text-sm text-primary" %>

<div class="space-y-6 mx-auto max-w-3xl mb-6">
  <div class="text-center space-y-2 max-w-xl mx-auto">
    <h1 class="text-3xl text-primary font-medium"><%= t(".title") %></h1>
    <p class="text-secondary text-sm"><%= t(".description") %></p>
  </div>

  <% if @tables.empty? %>
    <p class="text-sm text-secondary text-center"><%= t(".none") %></p>
    <%= render DS::Button.new(text: t(".back_to_imports"), href: imports_path, variant: :secondary, full_width: true) %>
  <% else %>
    <%= styled_form_with model: @import, scope: :import, url: import_sheet_selection_path(@import), method: :put, class: "space-y-4" do |form| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
        <%= form.select :date_format, Family::DATE_FORMATS + Import::CSV_ONLY_DATE_FORMATS, { label: t(".date_format_label") } %>
        <%= form.select :number_format, Import::NUMBER_FORMATS.keys, { label: t(".number_format_label") } %>
        <%= form.select :signage_convention,
                        [ [ t(".incomes_are_positive"), "inflows_positive" ], [ t(".incomes_are_negative"), "inflows_negative" ] ],
                        { label: t(".signage_label") } %>
      </div>
      <p class="text-xs text-secondary"><%= t(".formats_hint") %></p>

      <div class="bg-container-inset rounded-xl p-1 space-y-1">
        <% @tables.each_with_index do |table, index| %>
          <% field = "import[sheets][#{index}]" %>
          <% selection = @selections[table.name] || {} %>
          <% checked = selection.any? ? selection["selected"] == "1" : table.importable? %>
          <% column_options = table.headers.each_with_index.to_a %>

          <div class="bg-container shadow-border-xs rounded-lg p-4 space-y-3">
            <input type="hidden" name="<%= field %>[sheet_name]" value="<%= table.name %>">
            <input type="hidden" name="<%= field %>[selected]" value="0">

            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="<%= field %>[selected]" value="1" class="rounded border-primary" <%= "checked" if checked %>>
              <span class="text-sm font-medium text-primary"><%= table.name %></span>
              <span class="text-xs text-secondary"><%= t(".rows_count", count: table.data.size) %></span>
            </label>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pl-7">
              <select name="<%= field %>[account_id]" aria-label="<%= t(".account_label") %>" class="<%= select_class %>">
                <option value="new"><%= t(".create_new_account") %></option>
                <% @accounts.each do |account| %>
                  <option value="<%= account.id %>" <%= "selected" if selection["account_id"] == account.id %>><%= account.name %></option>
                <% end %>
              </select>

              <input type="text" autocomplete="off" name="<%= field %>[account_name]" value="<%= selection["account_name"].presence || table.name %>"
                     placeholder="<%= t(".new_account_name_placeholder") %>" aria-label="<%= t(".new_account_name_placeholder") %>" class="<%= select_class %>">
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 pl-7">
              <label class="text-xs text-secondary space-y-1">
                <span><%= t(".rows_to_skip_label") %></span>
                <input type="number" autocomplete="off" min="0" step="1" name="<%= field %>[rows_to_skip]" value="<%= table.rows_to_skip %>" class="<%= select_class %>">
              </label>
              <% { date: t(".date_col_label"), name: t(".name_col_label"), amount: t(".amount_col_label") }.each do |role, label| %>
                <label class="text-xs text-secondary space-y-1">
                  <span><%= label %></span>
                  <select name="<%= field %>[<%= role %>_col]" class="<%= select_class %>">
                    <option value=""><%= t(".no_column") %></option>
                    <%= options_for_select(column_options, table.columns[role]) %>
                  </select>
                </label>
              <% end %>
            </div>

            <% if table.data.any? %>
              <div class="pl-7 overflow-x-auto">
                <table class="text-xs text-secondary">
                  <thead>
                    <tr><% table.headers.each do |header| %><th class="text-left font-medium pr-3"><%= header %></th><% end %></tr>
                  </thead>
                  <tbody>
                    <% table.sample.each do |row| %>
                      <tr><% row.each do |cell| %><td class="pr-3 whitespace-nowrap"><%= cell %></td><% end %></tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex gap-2">
        <button type="submit" formmethod="get" formaction="<%= import_sheet_selection_path(@import) %>" formnovalidate
                class="shrink-0 rounded-lg border border-secondary px-3 py-2 text-sm text-primary">
          <%= t(".refresh") %>
        </button>
        <%= render DS::Button.new(text: t(".import_selected"), type: :submit, full_width: true) %>
      </div>
    <% end %>
  <% end %>
</div>
